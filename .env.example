# Local single-host defaults. Replace passwords before exposing this deployment.
POSTGRES_DB=gobrowse
POSTGRES_USER=gobrowse
POSTGRES_PASSWORD=local-development-change-before-production
GOBROWSE__DATABASE__URL=postgres://gobrowse:local-development-change-before-production@postgres:5432/gobrowse
GOBROWSE__DATABASE__MAX_CONNECTIONS=20
GOBROWSE__HTTP__BIND=0.0.0.0:8080
GOBROWSE__HTTP__PUBLIC_ORIGIN=http://localhost:8080
GOBROWSE__HTTP__SECURE_COOKIES=false
GOBROWSE__HTTP__STATIC_DIR=/app/dist
GOBROWSE__HTTP__REQUEST_BODY_LIMIT_BYTES=2097152
GOBROWSE__AUTH__SESSION_IDLE_MINUTES=120
GOBROWSE__AUTH__SESSION_ABSOLUTE_HOURS=336
GOBROWSE__AUTH__ARGON2_MEMORY_KIB=19456
GOBROWSE__AUTH__ARGON2_ITERATIONS=2
GOBROWSE__AUTH__ARGON2_PARALLELISM=1
GOBROWSE__AUTH__MAX_PARALLEL_HASHES=4
GOBROWSE__OBSERVABILITY__JSON_LOGS=true
GOBROWSE__OBSERVABILITY__LOG_FILTER=gobrowse=info,tower_http=info
GOBROWSE__FEATURES__SANDBOX=false
GOBROWSE__FEATURES__BROWSER=false
GOBROWSE__FEATURES__MESSAGING=false
GOBROWSE__FEATURES__VOICE=false
GOBROWSE__FEATURES__MEDIA=false
GOBROWSE__FEATURES__LSP=false
GOBROWSE__FEATURES__OTEL=false
GOBROWSE__FEATURES__LOCAL_EMBEDDINGS=false
